# Supabase
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Bing Webmaster Tools OAuth — https://www.bing.com/webmasters → Settings → API Access
# Redirect URI: https://yourdomain.com/auth/bing/callback
BING_WEBMASTER_CLIENT_ID=your-bing-client-id
BING_WEBMASTER_CLIENT_SECRET=your-bing-client-secret

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-random-32-char-string

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# AES-GCM key for encrypting stored OAuth refresh tokens (32 bytes, base64)
# Generate with: openssl rand -base64 32
DIGEST_ENCRYPTION_KEY=replace-with-random-base64-32-byte-key

# Your deployment URL
APP_BASE_URL=https://yourdomain.com
